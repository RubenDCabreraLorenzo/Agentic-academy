# Development defaults (quickstart.md "Environment variables"). No real secrets are needed locally.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://academy:academy@localhost:5432/academy
RUNNER_DATABASE_URL=postgresql+psycopg://academy_runner:runner@localhost:5432/academy
# Generated by `make dev-secrets`
SESSION_SECRET=
COOKIE_SECURE=true
PUBLIC_BASE_URL=http://localhost:5173
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agentic Academy <no-reply@academy.local>
CONTENT_DIR=./dist/content
CHALLENGES_ENABLED=false
RUNNER_RUNTIME=runsc
RUNNER_SANDBOX_IMAGE=academy-sandbox:dev
RUNNER_CONCURRENCY=2
RUNNER_OUT_DIR=./.runner-out
RATE_LIMIT_ENABLED=true
