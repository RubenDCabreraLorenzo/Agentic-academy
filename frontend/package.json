{
  "name": "agentic-academy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "lint": "eslint . && tsc -b --noEmit",
    "generate:api": "openapi-typescript ../specs/001-agentic-academy-mvp/contracts/openapi.yaml -o src/api/schema.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.1.6",
    "@tanstack/react-query": "^5.59.0",
    "@uiw/react-codemirror": "^4.23.0",
    "dompurify": "^3.1.7",
    "i18next": "^23.16.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "react-router": "^7.1.0",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
